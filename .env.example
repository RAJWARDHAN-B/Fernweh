# Copy to .env and fill in local values. Never commit .env.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./fernweh.db
# DATABASE_URL=postgresql+asyncpg://fernweh:fernweh@localhost:5432/fernweh

# --- LLM (LiteLLM model identifiers) ---
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30
# Provider keys as required by the chosen models, e.g.:
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Evals ---
EVAL_JUDGE_MODEL=

# --- Guardrails ---
GUARDRAILS_TOKEN=

# --- MCP servers ---
MCP_GEOCODING_URL=
MCP_WEATHER_URL=
